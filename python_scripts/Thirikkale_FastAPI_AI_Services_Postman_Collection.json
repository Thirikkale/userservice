  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Set base URLs",
          "pm.collectionVariables.set('SPRING_BASE_URL', 'http://localhost:8081/user-service');",
          "pm.collectionVariables.set('FASTAPI_BASE_URL', 'http://127.0.0.1:5000');"
        ]
      }

    {
      "name": "🔐 Authentication & Registration",
      "item": [
        {
          "name": "Register Super Admin (First Setup)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('ADMIN_ID', response.adminId);",
                  "    pm.collectionVariables.set('ADMIN_TOKEN', response.accessToken);",
                  "    pm.test('Super admin registered successfully', () => {",
                  "        pm.expect(response.success).to.be.true;",
                  "        pm.expect(response.adminRole).to.eql('ADMIN_ADMIN');",
                  "    });",
                  "} else if (pm.response.code === 409) {",
                  "    pm.test('Super admin already exists', () => {",
                  "        pm.expect(pm.response.code).to.eql(409);",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@thirikkale.com\",\n  \"password\": \"Admin123!\",\n  \"firstName\": \"Super\",\n  \"lastName\": \"Admin\"\n}"
            },
            "url": {
              "raw": "{{SPRING_BASE_URL}}/api/v1/auth/admin/register-super-admin",
              "host": ["{{SPRING_BASE_URL}}"],
              "path": ["api", "v1", "auth", "admin", "register-super-admin"]
            }
          }
        },
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('ADMIN_TOKEN', response.accessToken);",
                  "    pm.collectionVariables.set('ACCESS_TOKEN', response.accessToken);",
                  "    pm.test('Admin login successful', () => {",
                  "        pm.expect(response.success).to.be.true;",
                  "        pm.expect(response.accessToken).to.not.be.empty;",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailOrPhone\": \"admin@thirikkale.com\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": {
              "raw": "{{SPRING_BASE_URL}}/api/v1/auth/admin/login",
              "host": ["{{SPRING_BASE_URL}}"],
              "path": ["api", "v1", "auth", "admin", "login"]
            }
          }
        },

              "raw": "{{SPRING_BASE_URL}}/api/v1/riders/{{RIDER_ID}}/gender-detection",
              "host": ["{{SPRING_BASE_URL}}"],
              "path": ["api", "v1", "riders", "{{RIDER_ID}}", "gender-detection"]

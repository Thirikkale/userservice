  "item": [
    {
      "name": "🏥 Health Checks",
      "item": [
        {
          "name": "Spring Boot Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Spring Boot is healthy', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{SPRING_BASE_URL}}/actuator/health",
              "host": ["{{SPRING_BASE_URL}}"],
              "path": ["actuator", "health"]
            }
          }
        },
        {
          "name": "FastAPI Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('FastAPI AI Service is healthy', () => {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.status).to.eql('healthy');",
                  "    pm.expect(response.mode).to.be.oneOf(['MOCK', 'REAL']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{FASTAPI_BASE_URL}}/health",
              "host": ["{{FASTAPI_BASE_URL}}"],
              "path": ["health"]

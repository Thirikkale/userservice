    {
      "name": "🚶‍♀️ Rider AI Services",
      "item": [
        {
          "name": "Upload Rider Selfie for Gender Detection",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Gender detection successful', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('detectedGender');",
                  "    pm.expect(response).to.have.property('confidence');",
                  "    pm.expect(response.confidence).to.be.a('number');",
                  "    pm.expect(response.isVerified).to.be.a('boolean');",
                  "    console.log('Gender Detection Result:', JSON.stringify(response, null, 2));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{RIDER_TOKEN}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "selfie",
                  "type": "file",
                  "src": "/test_images/rider_selfie.jpg",
                  "description": "Upload a clear selfie photo for gender detection"
